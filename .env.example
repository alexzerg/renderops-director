# Google ADK / Vertex AI
GOOGLE_CLOUD_PROJECT=renderops-director-2026
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash

# Application: demo | live
RENDEROPS_MODE=demo

# Grafana MCP: demo | remote | stdio
GRAFANA_MCP_TRANSPORT=demo
GRAFANA_MCP_URL=https://mcp.grafana.com/mcp
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_MCP_BINARY=/usr/local/bin/mcp-grafana
# Set only in Secret Manager or your local untracked .env
GRAFANA_SERVICE_ACCOUNT_TOKEN=
